<?xml version="1.0" encoding="utf-8"?>
<!-- The user grants Accessibility explicitly. Normal learning is app-allowlisted;
     one-shot owner-requested text and OCR may read the foreground app (Android 11+). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="500"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:description="@string/brain_learning_description"
    android:settingsActivity="org.quantaphi.bubbles.MainActivity"/>
